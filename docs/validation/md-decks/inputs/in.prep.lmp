# Soft push-off and minimum-distance check for a generated cell.
units real
atom_style charge
boundary p p p
read_data ${data}
pair_style soft 3.2
pair_coeff * * 0.0 3.2
pair_coeff 1 1 0.0 3.0
pair_coeff 1 2 0.0 1.6
pair_coeff 2 2 0.0 2.5
variable prefactor equal ramp(0,300)
fix ramp all adapt 1 pair soft a * * v_prefactor
fix lim all nve/limit 0.05
fix lang all langevin 2000 2000 100.0 48279
thermo 1000
run 10000
unfix ramp
unfix lim
unfix lang
group oxy type 2
group cation type 1
compute cat_short cation coord/atom cutoff 1.3 group oxy
compute cat_bad all reduce max c_cat_short
compute cc_short cation coord/atom cutoff 2.5 group cation
compute cc_bad all reduce max c_cc_short
compute oo_short oxy coord/atom cutoff 1.6 group oxy
compute oo_bad all reduce max c_oo_short
thermo_style custom step temp pe c_cat_bad c_cc_bad c_oo_bad
run 0
print "PREP_MIN_CHECK cat_within_1.3A=$(c_cat_bad) cc_within_2.5A=$(c_cc_bad) oo_within_1.6A=$(c_oo_bad)"
write_data ${outdata} nocoeff
